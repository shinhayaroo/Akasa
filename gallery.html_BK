<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Gallery � AKASA Sports Club</title>

  <link rel="icon" type="image/png" sizes="5x5" href="assets/logo.png">

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  >

  <style>

:root{--bg:#f7f5f0;--ink:#111;--muted:#777;--blue:#1a6cff;--purple:#8b5cf6;--card-bg:#fff;--card-border:rgba(0,0,0,.05);--navbar-bg:rgba(247,245,240,.92);--footer-bg:#111}
html[data-theme="dark"]{--bg:#0f0f0f;--ink:#f0f0f0;--muted:#aaa;--blue:#1a6cff;--purple:#9d7ff6;--card-bg:#1a1a1a;--card-border:rgba(255,255,255,.1);--navbar-bg:rgba(15,15,15,.95);--footer-bg:#0a0a0a}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:'Plus Jakarta Sans',sans-serif;overflow-x:hidden}

/* NAVBAR */
.navbar{background:var(--navbar-bg);backdrop-filter:blur(14px);border-bottom:1px solid rgba(0,0,0,.07);padding:1rem 0;position:sticky;top:0;z-index:999}

/* THEME TOGGLE (fixed bottom-right) */
.theme-toggle{position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;width:46px;height:46px;border-radius:50%;border:1.5px solid rgba(0,0,0,.12);background:var(--bg);color:var(--ink);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.1rem;box-shadow:0 4px 18px rgba(0,0,0,.15);transition:transform .2s,box-shadow .2s,background-color .35s,border-color .35s}
.theme-toggle:hover{transform:rotate(20deg) scale(1.1);box-shadow:0 6px 22px rgba(0,0,0,.22)}
html[data-theme="dark"] .theme-toggle{border-color:rgba(255,255,255,.14)}
.navbar-brand{font-family:'Bebas Neue',sans-serif;font-size:2rem;letter-spacing:3px;color:var(--ink)!important}
.navbar-brand span{color:var(--blue)}
.nav-link{color:var(--muted)!important;font-size:.8rem;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;padding:.4rem .9rem!important}
.nav-link:hover,.nav-link.active-link{color:var(--ink)!important;font-weight:600}
.btn-nav{background:var(--blue);color:#fff!important;border-radius:50px;padding:.5rem 1.4rem!important;font-size:.78rem!important;font-weight:600!important}

/* HERO */
.page-hero{background:var(--bg);padding:5rem 0 3.5rem;position:relative;overflow:hidden}
.ph-blob{position:absolute;border-radius:50%;filter:blur(90px);opacity:.16;pointer-events:none}
.pb1{width:500px;height:500px;background:var(--purple);top:-180px;right:-100px}
.pb2{width:300px;height:300px;background:#ff7c2a;bottom:-80px;left:-60px}
.pb3{width:220px;height:220px;background:#00b4a0;top:40%;left:38%}
.breadcrumb-row{display:flex;align-items:center;gap:.5rem;font-size:.72rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin-bottom:1.5rem}
.breadcrumb-row a{color:var(--blue);text-decoration:none}
.page-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(3.5rem,10vw,8rem);line-height:.92;letter-spacing:-1px}
.page-title .c-purple{color:var(--purple)}
.hero-desc{font-size:1rem;color:var(--muted);max-width:520px;line-height:1.8;margin-top:1.2rem}
.stat-pills{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:2rem}
.stat-pill{display:inline-flex;align-items:center;gap:.45rem;background:var(--card-bg);border:1.5px solid var(--card-border);border-radius:50px;padding:.4rem 1rem;font-size:.72rem;font-weight:600;box-shadow:0 2px 10px rgba(0,0,0,.05)}
.stat-pill b{font-family:'Bebas Neue',sans-serif;font-size:1.1rem}

/* SCROLL MONTH / YEAR INDICATOR */
.scroll-date-indicator {
  position: fixed;
  top: 50%;
  right: 24px;
  left: auto;
  transform: translate(0, -50%);
  z-index: 900;
  display: flex;
  align-items: center;
  gap: .45rem;
  padding: .55rem .9rem;
  border-radius: 999px;
  background: rgba(255,255,255,.92);
  border: 1px solid rgba(0,0,0,.08);
  box-shadow: 0 6px 22px rgba(0,0,0,.08);
  backdrop-filter: blur(12px);
  opacity: 0;
  transform: translateY(-8px);
  pointer-events: none;
  transition: opacity .2s ease, transform .2s ease;
}

.scroll-date-indicator.visible {
  opacity: 1;
  transform: translate(0, -50%);
}

.scroll-date-indicator #scrollMonth {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.15rem;
  letter-spacing: .7px;
  color: var(--ink);
}

.scroll-date-indicator #scrollYear {
  font-size: .72rem;
  font-weight: 700;
  color: var(--muted);
  letter-spacing: 1px;
}

/* DARK MODE - SCROLL DATE INDICATOR */
html[data-theme="dark"] .scroll-date-indicator {
  background: rgba(30,30,30,.95);
  border-color: rgba(255,255,255,.12);
  box-shadow: 0 6px 22px rgba(0,0,0,.3);
}

/* IMAGE-ONLY GALLERY */
.gallery-wrap{padding:2.5rem 0 4rem}
.photo-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.15rem}
.photo-card{position:relative;aspect-ratio:4/3;overflow:hidden;border-radius:16px;background:var(--card-bg);cursor:pointer;border:1.5px solid var(--card-border);box-shadow:0 4px 18px rgba(0,0,0,.05);transition:transform .3s ease,box-shadow .3s ease}
.photo-card:hover{transform:translateY(-5px);box-shadow:0 15px 35px rgba(0,0,0,.12)}
.photo-card img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .45s ease}
.photo-card:hover img{transform:scale(1.06)}

/* IMAGE-ONLY LIGHTBOX */
.gallery-lightbox{position:fixed;inset:0;background:rgba(0,0,0,.96);z-index:9999;opacity:0;pointer-events:none;transition:opacity .25s ease;display:flex;align-items:center;justify-content:center}
.gallery-lightbox.open{opacity:1;pointer-events:auto}
.lightbox-image{max-width:calc(100vw - 140px);max-height:calc(100vh - 100px);width:auto;height:auto;object-fit:contain;display:block;transition:opacity .2s ease}
.lightbox-close,.lightbox-nav{position:absolute;width:48px;height:48px;border:0;border-radius:50%;background:rgba(255,255,255,.12);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .2s ease,transform .2s ease;z-index:2}
.lightbox-close:hover,.lightbox-nav:hover{background:rgba(255,255,255,.22)}
.lightbox-close{top:20px;right:20px;font-size:1.15rem}
.lightbox-nav{top:50%;transform:translateY(-50%);font-size:1.2rem}
.lightbox-nav.prev{left:22px}
.lightbox-nav.next{right:22px}
.lightbox-counter{position:absolute;top:25px;left:50%;transform:translateX(-50%);color:rgba(255,255,255,.7);font-size:.72rem;font-weight:600;letter-spacing:1px}

/* FOOTER */
footer{background:var(--footer-bg);color:#fff;padding:3rem 0 2rem;margin-top:2rem}
.footer-brand{font-family:'Bebas Neue',sans-serif;font-size:2rem;letter-spacing:3px}
.footer-brand span{color:var(--blue)}
.footer-link{color:rgba(255,255,255,.4);text-decoration:none;font-size:.78rem;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;display:inline-block;margin:0 .75rem}
.footer-link:hover{color:#fff}
.footer-copy{font-size:.72rem;color:rgba(255,255,255,.2);margin-top:1.5rem}
.footer-social a{width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.1);display:inline-flex;align-items:center;justify-content:center;color:rgba(255,255,255,.4);margin:0 .25rem;text-decoration:none}
.footer-social a:hover{background:var(--blue);color:#fff;border-color:var(--blue)}
.footer-divider{border-top:1px solid rgba(255,255,255,.07);margin:2rem 0 1.5rem}

@media(max-width:1100px){.photo-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:800px){
  .scroll-date-indicator {
    top: 50%;
    right: 12px;
    padding: .45rem .75rem;
  }

  .scroll-date-indicator #scrollMonth {
    font-size: 1rem;
  }

  .scroll-date-indicator #scrollYear {
    font-size: .65rem;
  }

  .photo-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}
  .lightbox-image{max-width:calc(100vw - 80px);max-height:calc(100vh - 80px)}
  .lightbox-nav{width:40px;height:40px}
  .lightbox-nav.prev{left:10px}.lightbox-nav.next{right:10px}
}
@media(max-width:480px){
  .photo-grid{grid-template-columns:1fr}
  .photo-card{aspect-ratio:16/10}
  .page-hero{padding:3.5rem 0 2.5rem}
  .lightbox-close{top:12px;right:12px}
  .lightbox-counter{top:18px}
}

  </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg">
  <div class="container">
    <a class="navbar-brand" href="index.html">AKASA<span>.</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse justify-content-end" id="navMenu">
      <ul class="navbar-nav align-items-lg-center gap-lg-1">
        <li class="nav-item"><a class="nav-link" href="index.html">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="index.html#about">About</a></li>
        <li class="nav-item"><a class="nav-link" href="index.html#activities">Activities</a></li>
        <li class="nav-item"><a class="nav-link active-link" href="gallery.html">Gallery</a></li>
        <li class="nav-item"><a class="nav-link" href="index.html#committee">Committee</a></li>
        <li class="nav-item ms-lg-2"><a class="nav-link btn-nav" href="index.html#join">Join Us</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- HERO -->
<section class="page-hero">
  <div class="ph-blob pb1"></div>
  <div class="ph-blob pb2"></div>
  <div class="ph-blob pb3"></div>
  <div class="container">
    <div class="breadcrumb-row">
      <a href="index.html">Home</a>
      <i class="bi bi-chevron-right"></i>
      <span>Gallery</span>
    </div>
    <h1 class="page-title">PHOTO<br><span class="c-purple">GALLERY</span></h1>
    <p class="hero-desc">Relive the action, the victories, and the community spirit.</p>
    <div class="stat-pills">
      <div class="stat-pill">
        <i class="bi bi-images" style="color:var(--purple)"></i>
        <b id="photoCount">0</b> Photos
      </div>
      <div class="stat-pill">
        <i class="bi bi-sort-down" style="color:var(--blue)"></i>
        Latest First
      </div>
    </div>
  </div>
</section>

<!-- SCROLL DATE INDICATOR -->
<div class="scroll-date-indicator" id="scrollDateIndicator" aria-hidden="true">
  <span id="scrollMonth">March</span>
  <span id="scrollYear">2025</span>
</div>

<!-- ALL PHOTOS -->
<main class="gallery-wrap">
  <div class="container">
    <div id="photoGrid" class="photo-grid"></div>
  </div>
</main>

<!-- IMAGE-ONLY LIGHTBOX -->
<div class="gallery-lightbox" id="galleryLightbox" aria-hidden="true">
  <div class="lightbox-counter">
    <span id="lightboxCurrent">1</span> /
    <span id="lightboxTotal">1</span>
  </div>

  <button class="lightbox-close" id="lightboxClose" aria-label="Close">
    <i class="bi bi-x-lg"></i>
  </button>

  <button class="lightbox-nav prev" id="lightboxPrev" aria-label="Previous photo">
    <i class="bi bi-chevron-left"></i>
  </button>

  <img class="lightbox-image" id="lightboxImage" src="" alt="AKASA Sports Club gallery photo">

  <button class="lightbox-nav next" id="lightboxNext" aria-label="Next photo">
    <i class="bi bi-chevron-right"></i>
  </button>
</div>

<!-- FOOTER -->
<footer>
  <div class="container text-center">
    <div class="footer-brand mb-2">AKASA<span>.</span></div>
    <div class="mb-3">
      <a href="index.html#about" class="footer-link">About</a>
      <a href="index.html#activities" class="footer-link">Activities</a>
      <a href="events.html" class="footer-link">Events</a>
      <a href="gallery.html" class="footer-link">Gallery</a>
      <a href="index.html#committee" class="footer-link">Committee</a>
      <a href="index.html#join" class="footer-link">Join Us</a>
    </div>
    <div class="footer-social mb-3">
      <a href="#"><i class="bi bi-instagram"></i></a>
      <a href="#"><i class="bi bi-facebook"></i></a>
      <a href="#"><i class="bi bi-twitter-x"></i></a>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-copy">� 2025 AKASA Sports Club. All rights reserved.</div>
  </div>
</footer>

<!-- THEME TOGGLE (fixed bottom-right) -->
<button class="theme-toggle" id="themeToggle" title="Toggle dark / light mode">
  <i class="bi bi-moon-fill" id="themeIcon"></i>
</button>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
/* ============================================================
   DARK/LIGHT THEME TOGGLE (Synchronized with index.html)
============================================================ */
(function() {
  const root = document.documentElement;
  const toggleBtn = document.getElementById('themeToggle');
  const themeIcon = document.getElementById('themeIcon');

  function applyTheme(dark) {
    root.setAttribute('data-theme', dark ? 'dark' : 'light');
    themeIcon.className = dark ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
    localStorage.setItem('akasa-theme', dark ? 'dark' : 'light');
  }

  // Restore saved preference, fall back to dark theme by default (matching index.html)
  const saved = localStorage.getItem('akasa-theme');
  applyTheme(saved ? saved === 'dark' : true);

  // Toggle on click
  toggleBtn.addEventListener('click', () => {
    applyTheme(root.getAttribute('data-theme') !== 'dark');
  });
})();

/* ============================================================
   EXISTING PHOTO DATA
============================================================ */
const albums = [
  {
    title: 'AKASA Cup Futsal Tournament 2025',
    cat: 'Futsal', color: '#1a6cff',
    date: '15 March 2025',
    desc: '16 teams competed across Open, Under-21, and Women\'s divisions at Stadium MPSN.',
    photos: [
      { title:'Opening Ceremony & Team Parade',       date:'15 Mar 2025 · 8:00 AM',  desc:'All 16 teams line up for the official opening ceremony. The YDP flagged off the tournament to thunderous applause from the 300-strong crowd filling the stands.',              credit:'Media Team / AKASA', src:'https://drive.google.com/uc?id=1ci1OqwN0ms2Dt93x4F0SIwVHAXR95QL-&confirm=t' },
      { title:'Group Stage Action - Court 1',         date:'15 Mar 2025 · 9:15 AM',  desc:'Fast-paced group stage action as Team Striker FC takes on United Knights in a tense 0-0 draw. Both goalkeepers produced outstanding saves throughout the match.',             credit:'Media Team / AKASA', src:'https://drive.google.com/uc?id=1VtQXvH9tg3gIThgxgyLBsfBYYhjTmtLG&confirm=t' },
      { title:'Pre-Match Team Huddle',                date:'15 Mar 2025 · 12:00 PM', desc:'Coach delivers last-minute tactical instructions to AKASA A team before their quarter-final clash. The team went on to win 3-1 and advance to the semis.',                  credit:'Media Team / AKASA', src:'https://drive.google.com/uc?id=1_M-t6MdS3Vx0WPYcKdOOUgqS273EvdYO&confirm=t' },
      { title:'Semi-Final - AKASA A vs Dynamo FC',    date:'15 Mar 2025 · 3:00 PM',  desc:'A fiercely contested semi-final saw AKASA A edge past Dynamo FC 2-1 with a stunning long-range goal in the dying minutes of the second half.',                              credit:'Media Team / AKASA', src:'https://drive.google.com/uc?id=1Ru9WoIXhOD0_bxl9G3k0UbjKYCucG_BX&confirm=t' },
      { title:'Grand Final - Golden Goal Moment',     date:'15 Mar 2025 · 5:20 PM',  desc:'The moment that decided it all. Striker FC\'s captain unleashes a golden goal in extra time, sending the crowd into a frenzy and winning the AKASA Cup 2025.',               credit:'Media Team / AKASA', src:'https://drive.google.com/uc?id=1g7ii7v8LEontvbVl_gw4dZanw_NpboVG&confirm=t' },
      { title:'Champions Lift the Trophy',            date:'15 Mar 2025 � 5:55 PM',  desc:'Striker FC\'s captain raises the AKASA Cup 2025 trophy high as confetti rains down. A well-deserved victory for a team that went unbeaten across all 5 matches.',           credit:'Media Team / AKASA', src:'https://images.unsplash.com/photo-1546519638-68e109498ffc?w=1200&auto=format&fit=crop' },
      { title:'Prize Giving & Medal Ceremony',        date:'15 Mar 2025 � 6:00 PM',  desc:'The President presents medals and trophies to all division winners. Over RM 3,000 in prize money distributed across the three divisions.',                                   credit:'Media Team / AKASA', src:'https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=1200&auto=format&fit=crop' },
    ]
  },
];

/* ============================================================
   FLATTEN ALL PHOTOS
   Only src + date are used by this page.
============================================================ */

const allPhotos = albums.flatMap(album =>
  album.photos.map(photo => ({
    src: photo.src,
    date: photo.date
  }))
);


/* ============================================================
   DATE PARSER
============================================================ */

function parsePhotoDate(value) {
  const match = value.match(
    /^(\d{1,2})\s+([A-Za-z]{3})\s+(\d{4})(?:\s+�\s+(\d{1,2}):(\d{2})\s*(AM|PM))?/
  );

  if (!match) return new Date(0);

  const [, day, monthName, year, hour = "0", minute = "0", ampm] = match;

  const months = {
    Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5,
    Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11
  };

  const month = months[monthName];

  if (month === undefined) return new Date(0);

  let hours = Number(hour);

  if (ampm === "PM" && hours !== 12) hours += 12;
  if (ampm === "AM" && hours === 12) hours = 0;

  return new Date(
    Number(year),
    month,
    Number(day),
    hours,
    Number(minute),
    0
  );
}


/* ============================================================
   SORT LATEST ? OLDEST
============================================================ */

allPhotos.sort(
  (a, b) =>
    parsePhotoDate(b.date) - parsePhotoDate(a.date)
);


/* ============================================================
   RENDER PHOTO GRID
============================================================ */

const photoGrid =
  document.getElementById("photoGrid");

const photoCount =
  document.getElementById("photoCount");

const scrollDateIndicator =
  document.getElementById("scrollDateIndicator");

const scrollMonth =
  document.getElementById("scrollMonth");

const scrollYear =
  document.getElementById("scrollYear");

photoCount.textContent =
  allPhotos.length;


/*
  Each image gets a date data attribute.
  The actual date is NOT displayed on the image.
*/

allPhotos.forEach((photo, index) => {

  const card =
    document.createElement("div");

  card.className =
    "photo-card";

  card.dataset.photoIndex =
    index;

  card.dataset.photoDate =
    parsePhotoDate(photo.date)
      .getTime();

  card.tabIndex = 0;

  card.setAttribute(
    "role",
    "button"
  );

  card.setAttribute(
    "aria-label",
    "Open gallery photo"
  );


  const image =
    document.createElement("img");

  image.src =
    photo.src;

  image.alt =
    "AKASA Sports Club gallery photo";

  image.loading =
    index < 8
      ? "eager"
      : "lazy";


  card.appendChild(image);


  card.addEventListener(
    "click",
    () => openLightbox(index)
  );


  card.addEventListener(
    "keydown",
    event => {

      if (
        event.key === "Enter" ||
        event.key === " "
      ) {

        event.preventDefault();

        openLightbox(index);

      }

    }
  );


  photoGrid.appendChild(card);

});


/* ============================================================
   SCROLL MONTH / YEAR
   Shows the month/year of the image currently at the
   top/visible part of the gallery while scrolling.
============================================================ */

const photoCards =
  Array.from(
    document.querySelectorAll(".photo-card")
  );


function getPhotoMonthYear(photo) {

  const date =
    parsePhotoDate(photo.date);

  return {
    month:
      date.toLocaleDateString(
        "en-US",
        { month: "long" }
      ),

    year:
      date.getFullYear()
  };

}


function updateScrollDate() {

  if (!photoCards.length) {
    return;
  }


  /*
    Use a point near the upper part of the viewport.
    Find the latest image whose top has passed that point.
    This makes the indicator follow the image currently
    being viewed as the user scrolls.
  */

  const referenceY = 150;

  let activeIndex = 0;


  for (
    let i = 0;
    i < photoCards.length;
    i++
  ) {

    const rect =
      photoCards[i].getBoundingClientRect();


    if (
      rect.top <= referenceY
    ) {

      activeIndex = i;

    } else {

      break;

    }

  }


  const activePhoto =
    allPhotos[activeIndex];


  if (!activePhoto) {
    return;
  }


  const date =
    getPhotoMonthYear(
      activePhoto
    );


  scrollMonth.textContent =
    date.month;

  scrollYear.textContent =
    date.year;


  /*
    Hide the indicator near the very top of
    the page; show it once the gallery begins.
  */

  if (
    window.scrollY > 250
  ) {

    scrollDateIndicator.classList.add(
      "visible"
    );

  } else {

    scrollDateIndicator.classList.remove(
      "visible"
    );

  }

}


let scrollTicking = false;


window.addEventListener(
  "scroll",
  () => {

    if (!scrollTicking) {

      window.requestAnimationFrame(
        () => {

          updateScrollDate();

          scrollTicking = false;

        }
      );

      scrollTicking = true;

    }

  },
  { passive: true }
);


window.addEventListener(
  "resize",
  updateScrollDate
);


/* Initial state */
updateScrollDate();


/* ============================================================
   IMAGE-ONLY LIGHTBOX
============================================================ */

const lightbox =
  document.getElementById("galleryLightbox");

const lightboxImage =
  document.getElementById("lightboxImage");

const lightboxCurrent =
  document.getElementById("lightboxCurrent");

const lightboxTotal =
  document.getElementById("lightboxTotal");

let currentIndex = 0;

lightboxTotal.textContent = allPhotos.length;


/* OPEN */

function openLightbox(index) {

  currentIndex = index;

  updateLightbox();

  lightbox.classList.add("open");
  lightbox.setAttribute("aria-hidden", "false");

  document.body.style.overflow = "hidden";

}


/* CLOSE */

function closeLightbox() {

  lightbox.classList.remove("open");
  lightbox.setAttribute("aria-hidden", "true");

  document.body.style.overflow = "";

}


/* UPDATE */

function updateLightbox() {

  const photo = allPhotos[currentIndex];

  lightboxImage.style.opacity = "0";

  setTimeout(() => {

    lightboxImage.src = photo.src;
    lightboxImage.alt = "AKASA Sports Club gallery photo";
    lightboxImage.style.opacity = "1";

  }, 100);

  lightboxCurrent.textContent = currentIndex + 1;

}


/* PREVIOUS */

function previousPhoto() {

  currentIndex =
    (currentIndex - 1 + allPhotos.length) %
    allPhotos.length;

  updateLightbox();

}


/* NEXT */

function nextPhoto() {

  currentIndex =
    (currentIndex + 1) %
    allPhotos.length;

  updateLightbox();

}


/* BUTTONS */

document
  .getElementById("lightboxClose")
  .addEventListener("click", closeLightbox);

document
  .getElementById("lightboxPrev")
  .addEventListener("click", previousPhoto);

document
  .getElementById("lightboxNext")
  .addEventListener("click", nextPhoto);


/* CLICK OUTSIDE IMAGE */

lightbox.addEventListener("click", event => {

  if (event.target === lightbox) {
    closeLightbox();
  }

});


/* KEYBOARD */

document.addEventListener("keydown", event => {

  if (!lightbox.classList.contains("open")) {
    return;
  }

  if (event.key === "ArrowLeft") {
    previousPhoto();
  }

  if (event.key === "ArrowRight") {
    nextPhoto();
  }

  if (event.key === "Escape") {
    closeLightbox();
  }

});
</script>


</body>
</html>
