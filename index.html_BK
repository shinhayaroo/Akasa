<section id="activities">
  <div class="container">
    <div class="row align-items-end mb-5">
      <div class="col-lg-6 reveal">
        <div class="sec-label c-orange">What We Do</div>
        <h2 class="sec-title">Our <span class="c-blue">Activities</span></h2>
      </div>
      <div class="col-lg-5 offset-lg-1 reveal">
        <p class="sec-desc">A wide range of sports, leisure, and bonding activities designed to connect members, build teamwork, and create memorable experiences together.</p>
      </div>
    </div>

    <div class="row g-4">

      <div class="col-md-6 col-lg-4 reveal">
        <div class="activity-card">
          <div class="top-bar" style="background:var(--blue)"></div>
          <div class="activity-icon bg-blue"><i class="fa-solid fa-volleyball"></i></div>
          <h5>Volleyball</h5>
          <p>A fun team sport activity that improves teamwork, communication, fitness, and coordination among members.</p>
          <div class="activity-day c-blue"><i class="bi bi-clock me-1"></i>Club Schedule</div>
        </div>
      </div>

      <div class="col-md-6 col-lg-4 reveal">
        <div class="activity-card">
          <div class="top-bar" style="background:var(--orange)"></div>
          <div class="activity-icon bg-orange"><i class="fa-solid fa-futbol"></i></div>
          <h5>Futsal</h5>
          <p>An energetic indoor football activity that builds stamina, teamwork, strategy, and friendly competition.</p>
          <div class="activity-day c-orange"><i class="bi bi-clock me-1"></i>Club Schedule</div>
        </div>
      </div>

      <div class="col-md-6 col-lg-4 reveal">
        <div class="activity-card">
          <div class="top-bar" style="background:var(--green)"></div>
          <div class="activity-icon bg-green"><i class="bi bi-dice-5-fill"></i></div>
          <h5>Boardgame</h5>
          <p>A relaxed indoor activity where members can enjoy strategic games, improve thinking skills, and strengthen friendships.</p>
          <div class="activity-day c-green"><i class="bi bi-clock me-1"></i>Club Schedule</div>
        </div>
      </div>

      <div class="col-md-6 col-lg-4 reveal">
        <div class="activity-card">
          <div class="top-bar" style="background:var(--red)"></div>
          <div class="activity-icon bg-red"><i class="fa-solid fa-umbrella-beach"></i></div>
          <h5>Bonding / Staycation Session</h5>
          <p>A special gathering session for members to relax, connect, share ideas, and build stronger team spirit outside regular activities.</p>
          <div class="activity-day c-red"><i class="bi bi-clock me-1"></i>Club Schedule</div>
        </div>
      </div>

      <div class="col-md-6 col-lg-4 reveal">
        <div class="activity-card">
          <div class="top-bar" style="background:var(--teal)"></div>
          <div class="activity-icon bg-teal"><i class="fa-solid fa-fish"></i></div>
