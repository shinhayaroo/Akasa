            <div class="stat-label">Sports</div>
          </div>
          <div class="hero-stat">
            <div class="stat-num c-green">47</div>
            <div class="stat-label">Trophies</div>
          </div>
          <div class="hero-stat">
            <div class="stat-num c-purple">6+</div>
            <div class="stat-label">Years</div>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-5 offset-lg-1" style="position:relative">
        <div class="hero-card-big">
          <div class="hero-slideshow">
            <div class="slide active">
              <img src="assets/1.jpeg" alt="Photo 1">
            </div>
            <div class="slide">
              <img src="assets/2.jpeg" alt="Photo 2">
            </div>
            <div class="slide">
              <img src="assets/3.jpeg" alt="Photo 3">
            </div>
            <div class="slide">
              <img src="assets/4.jpeg" alt="Photo 4">
            </div>
