<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>AKASA Sport Club</title>
  <link rel="icon" type="image/png" sizes="5x5" href="assets/logo.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --bg:       #f7f5f0;
      --bg2:      #eeecea;
      --ink:      #111111;
      --muted:    #777;
      --red:      #ff3b30;
      --orange:   #ff7c2a;
      --yellow:   #ffc700;
      --green:    #1db954;
      --blue:     #1a6cff;
      --purple:   #8b5cf6;
      --pink:     #f72585;
      --teal:     #00b4a0;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 400;
      overflow-x: hidden;
    }

    /* ─── NAVBAR ─── */
    .navbar {
      background: rgba(247,245,240,0.9);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(0,0,0,0.07);
      padding: 1rem 0;
      position: sticky;
      top: 0;
      z-index: 999;
    }
    .navbar-brand {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2rem;
      letter-spacing: 3px;
      color: var(--ink) !important;
    }
    .navbar-brand span { color: var(--blue); }
    .nav-link {
      color: var(--muted) !important;
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      transition: color 0.2s;
      padding: 0.4rem 0.9rem !important;
    }
    .nav-link:hover { color: var(--ink) !important; }
    .btn-nav {
      background: var(--blue);
      color: #fff !important;
      border-radius: 50px;
      padding: 0.5rem 1.4rem !important;
      font-size: 0.78rem !important;
      font-weight: 600 !important;
      letter-spacing: 1px;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-nav:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(26,108,255,0.3); color: #fff !important; }
    .navbar-toggler { border: 1.5px solid rgba(0,0,0,0.15); }

    /* ─── HERO ─── */
    #hero {
      background: var(--bg);
      padding: 7rem 0 5rem;
      position: relative;
      overflow: hidden;
    }
    .hero-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.22;
      pointer-events: none;
    }
    .blob1 { width: 500px; height: 500px; background: var(--blue);  top: -120px; right: -60px; }
    .blob2 { width: 350px; height: 350px; background: var(--yellow); bottom: -80px; left: -60px; }
    .blob3 { width: 280px; height: 280px; background: var(--pink);  top: 40%; right: 20%; }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: #fff;
      border: 1.5px solid rgba(0,0,0,0.08);
      border-radius: 50px;
      padding: 0.4rem 1rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: 1.8rem;
      box-shadow: 0 2px 12px rgba(26,108,255,0.08);
      animation: fadeUp 0.7s ease both;
    }
    .hero-badge .dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--green);
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(29,185,84,0.4); }
      50%      { box-shadow: 0 0 0 6px rgba(29,185,84,0); }
    }

    .hero-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(4.5rem, 12vw, 6rem);
      line-height: 0.92;
      letter-spacing: -1px;
      animation: fadeUp 0.7s ease 0.1s both;
    }

    .hero-sub {
      font-size: 1.05rem;
      color: var(--muted);
      max-width: 420px;
      line-height: 1.8;
      margin-top: 1.5rem;
      animation: fadeUp 0.7s ease 0.2s both;
    }

    .hero-cta {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 2.2rem;
      animation: fadeUp 0.7s ease 0.3s both;
    }
    .btn-primary-custom {
      background: var(--blue);
      color: #fff;
      border: none;
      border-radius: 50px;
      padding: 0.85rem 2.2rem;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
      display: inline-block;
    }
    .btn-primary-custom:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(26,108,255,0.3); color: #fff; }
    .btn-outline-custom {
      background: transparent;
      color: var(--ink);
      border: 1.5px solid rgba(0,0,0,0.15);
      border-radius: 50px;
      padding: 0.85rem 2.2rem;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
      transition: border-color 0.2s, transform 0.2s;
      display: inline-block;
    }
    .btn-outline-custom:hover { border-color: var(--ink); transform: translateY(-3px); color: var(--ink); }

    .hero-stats {
      display: flex;
      margin-top: 4rem;
      animation: fadeUp 0.7s ease 0.4s both;
      border: 1.5px solid rgba(0,0,0,0.08);
      border-radius: 16px;
      overflow: hidden;
      background: #fff;
      max-width: 480px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }
    .hero-stat {
      flex: 1;
      text-align: center;
      padding: 1.2rem 0.5rem;
      border-right: 1.5px solid rgba(0,0,0,0.08);
    }
    .hero-stat:last-child { border-right: none; }
    .stat-num {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2.2rem;
      line-height: 1;
    }
    .stat-label {
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      margin-top: 0.2rem;
    }

    /* hero visual card */
    .hero-card-big {
      background: linear-gradient(135deg, var(--blue), #4f9cff);
      border-radius: 24px;
      height: 420px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }
    .hero-card-big .icon-big {
      font-size: 9rem;
      color: rgba(255,255,255,0.18);
      position: absolute;
      width: 220px;   /* change to 30px if you want smaller */
      height: auto;
      opacity: 0.6;   /* 0 = fully transparent, 1 = fully visible */
    }
    .hero-card-big .label-over {
      position: absolute;
      bottom: 1.8rem; left: 1.8rem;
      color: #fff;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2rem;
      letter-spacing: 3px;
    }
    .floating-pill {
      position: absolute;
      background: #fff;
      border-radius: 50px;
      padding: 0.6rem 1.2rem;
      font-size: 0.78rem;
      font-weight: 600;
      box-shadow: 0 8px 24px rgba(0,0,0,0.12);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      white-space: nowrap;
      animation: float 3s ease-in-out infinite;
    }
    .pill1 { top: 1.5rem; right: -1.5rem; animation-delay: 0s; }
    .pill2 { bottom: 5rem; right: -2rem;  animation-delay: 1s; }
    .pill3 { top: 45%;   left: -2rem;    animation-delay: 0.5s; }
    @keyframes float {
      0%,100% { transform: translateY(0); }
      50%      { transform: translateY(-8px); }
    }
    .pill-dot { width:10px; height:10px; border-radius:50%; }

    /* ─── HERO SLIDESHOW ─── */
    .hero-slideshow {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border-radius: 24px;
      overflow: hidden;
    }
    .hero-slideshow .slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 1s ease;
    }
    .hero-slideshow .slide.active { opacity: 1; }
    .hero-slideshow .slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .slideshow-dots {
      position: absolute;
      bottom: 1.2rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 0.45rem;
      z-index: 2;
    }
    .slideshow-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: rgba(255,255,255,0.45);
      cursor: pointer;
      transition: background 0.3s, transform 0.3s;
    }
    .slideshow-dot.active {
      background: #fff;
      transform: scale(1.35);
    }
    .hero-slide-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      background: rgba(255,255,255,0.22);
      border: none;
      backdrop-filter: blur(6px);
      color: #fff;
      font-size: 2rem;
      line-height: 1;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, transform 0.2s;
      padding: 0;
    }
    .hero-slide-btn:hover { background: rgba(255,255,255,0.42); transform: translateY(-50%) scale(1.1); }
    .hero-slide-prev { left: 0.6rem; }
    .hero-slide-next { right: 0.6rem; }

    /* ─── MOBILE ADJUSTMENTS ─── */
    @media (max-width: 991.98px) {
      .hero-card-big { height: 280px; border-radius: 18px; }
      .hero-slideshow { border-radius: 18px; }
      .pill1 { top: 1rem;  right: 0.5rem; }
      .pill2 { bottom: 3.5rem; right: 0.5rem; }
      .pill3 { top: 45%;  left: 0.5rem; }
    }

    /* ─── SECTION COMMON ─── */
    section { padding: 7rem 0; }
    .sec-label {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
    }
    .sec-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      line-height: 1;
      letter-spacing: 0.5px;
    }
    .sec-desc {
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.8;
      max-width: 480px;
    }

    /* ─── ABOUT ─── */
    #about { background: #fff; }
    .about-highlight {
      border-left: 4px solid var(--blue);
      padding: 1.2rem 1.5rem;
      background: rgba(26,108,255,0.04);
      border-radius: 0 12px 12px 0;
      font-size: 1rem;
      color: #444;
      line-height: 1.8;
      font-style: italic;
    }
    .fact-box {
      border-radius: 16px;
      padding: 1.5rem;
      text-align: center;
      color: #fff;
    }
    .fact-num {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2.8rem;
      line-height: 1;
    }
    .fact-lbl {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      opacity: 0.8;
      margin-top: 0.3rem;
    }

    /* ─── ACTIVITIES ─── */
    #activities { background: var(--bg2); }

    /* ─── EVENTS (picture cards) ─── */
    #events { background: #fff; }
    .event-card {
      background: var(--bg);
      border-radius: 24px;
      overflow: hidden;
      height: 100%;
      transition: transform 0.35s, box-shadow 0.35s;
      border: 1.5px solid rgba(0,0,0,0.05);
    }
    .event-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 24px 60px rgba(0,0,0,0.11);
    }
    .event-img-wrap {
      position: relative;
      overflow: hidden;
      height: 230px;
    }
    .event-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .event-card:hover .event-img-wrap img { transform: scale(1.06); }
    .event-cat-badge {
      position: absolute;
      top: 1rem; left: 1rem;
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 0.3rem 0.8rem;
      border-radius: 50px;
      color: #fff;
    }
    .event-status {
      position: absolute;
      top: 1rem; right: 1rem;
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 0.3rem 0.7rem;
      border-radius: 50px;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(6px);
    }
    .event-body { padding: 1.6rem; }
    .event-date-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.75rem;
    }
    .event-date-row .date-icon {
      width: 26px; height: 26px;
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.75rem;
      color: #fff;
      flex-shrink: 0;
    }
    .event-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.45rem;
      letter-spacing: 1px;
      line-height: 1.1;
      margin-bottom: 0.6rem;
    }
    .event-desc {
      font-size: 0.84rem;
      color: var(--muted);
      line-height: 1.7;
    }
    .event-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.6rem 1.4rem;
      border-top: 1.5px solid rgba(0,0,0,0.06);
      margin-top: 0.5rem;
    }
    .event-meta {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--muted);
    }
    .event-meta i { font-size: 0.85rem; }
    .event-btn {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
      padding: 0.4rem 1rem;
      border-radius: 50px;
      color: #fff;
      transition: transform 0.2s, box-shadow 0.2s;
      display: inline-block;
    }
    .event-btn:hover { transform: translateY(-2px); color: #fff; }
    /* featured big card */
    .event-card-featured { position: relative; }
    .event-card-featured .event-img-wrap { height: 320px; }
    .event-card-featured .event-title { font-size: 1.8rem; }
    .activity-card {
      background: #fff;
      border-radius: 20px;
      padding: 2rem 1.8rem;
      height: 100%;
      transition: transform 0.3s, box-shadow 0.3s;
      border: 1.5px solid transparent;
    }
    .activity-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 50px rgba(0,0,0,0.1);
    }
    .activity-card .top-bar {
      height: 4px;
      border-radius: 4px;
      margin-bottom: 1.5rem;
    }
    .activity-icon {
      width: 52px; height: 52px;
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem;
      color: #fff;
      margin-bottom: 1.2rem;
    }
    .activity-card h5 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.5rem;
      letter-spacing: 1px;
      margin-bottom: 0.5rem;
    }
    .activity-card p { font-size: 0.85rem; color: var(--muted); line-height: 1.7; }
    .activity-day {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-top: 1.2rem;
      background: var(--bg);
      padding: 0.35rem 0.85rem;
      border-radius: 50px;
    }

    /* ─── GALLERY PREVIEW ─── */
    #gallery { background: var(--bg2); }
    .gallery-card {
      background: #fff;
      border-radius: 20px;
      overflow: hidden;
      border: 1.5px solid rgba(0,0,0,0.05);
      transition: transform 0.3s, box-shadow 0.3s;
      cursor: pointer;
      height: 100%;
    }
    .gallery-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 50px rgba(0,0,0,0.12);
    }
    .gallery-img-wrap {
      position: relative;
      height: 210px;
      overflow: hidden;
    }
    .gallery-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .gallery-card:hover .gallery-img-wrap img { transform: scale(1.07); }
    .gallery-cat-badge {
      position: absolute;
      top: 0.85rem; left: 0.85rem;
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 0.25rem 0.7rem;
      border-radius: 50px;
      color: #fff;
      z-index: 2;
    }
    .gallery-photo-count {
      position: absolute;
      top: 0.85rem; right: 0.85rem;
      background: rgba(0,0,0,0.5);
      backdrop-filter: blur(6px);
      color: #fff;
      font-size: 0.65rem;
      font-weight: 700;
      padding: 0.28rem 0.7rem;
      border-radius: 50px;
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }
    .gallery-hover-hint {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0);
      transition: background 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .gallery-card:hover .gallery-hover-hint { background: rgba(0,0,0,0.18); }
    .gallery-hint-pill {
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(8px);
      border-radius: 50px;
      padding: 0.45rem 1.1rem;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.8px;
      color: var(--ink);
      opacity: 0;
      transform: translateY(8px);
      transition: all 0.3s;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .gallery-card:hover .gallery-hint-pill { opacity: 1; transform: translateY(0); }
    .gallery-body {
      padding: 1.1rem 1.3rem 0.9rem;
    }
    .gallery-date {
      font-size: 0.68rem;
      font-weight: 600;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 0.35rem;
      margin-bottom: 0.4rem;
    }
    .gallery-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.2rem;
      letter-spacing: 0.5px;
      line-height: 1.1;
    }
    .gallery-desc {
      font-size: 0.78rem;
      color: var(--muted);
      line-height: 1.65;
      margin-top: 0.35rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* ─── COMMITTEE ─── */
    #committee { background: #fff; }
    #committee .row {
      align-items: stretch;
    }
    #committee .col-sm-6,
    #committee .col-md-4,
    #committee .col-lg-3 {
      display: flex;
    }
    .member-card {
      background: var(--bg);
      border-radius: 20px;
      padding: 2rem 1.5rem;
      text-align: center;
      transition: transform 0.3s, box-shadow 0.3s;
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
    }
    .member-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 40px rgba(0,0,0,0.09);
    }
    .member-avatar {
      width: 80px; height: 80px;
      border-radius: 50%;
      margin: 0 auto 1rem;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.6rem;
      color: #fff;
    }
    .member-avatar-img {
      width: 110px; height: 133px;
      margin: 0 auto 1rem;
      object-fit: cover;
      display: block;
    }
    .member-role-badge {
      display: inline-block;
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 0.25rem 0.7rem;
      border-radius: 50px;
      color: #fff;
      margin-bottom: 0.6rem;
    }
    .member-name {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.25rem;
      letter-spacing: 1px;
    }
    .member-desc {
      font-size: 0.8rem;
      color: var(--muted);
      margin-top: 0.5rem;
      line-height: 1.6;
    }
    .member-social { margin-top: 1rem; }
    .member-social a {
      width: 30px; height: 30px;
      border-radius: 50%;
      background: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      margin: 0 0.2rem;
      font-size: 0.85rem;
      transition: background 0.2s, color 0.2s;
      text-decoration: none;
    }
    .member-social a:hover { background: var(--blue); color: #fff; }

    /* ─── JOIN ─── */
    #join { background: var(--bg2); padding: 7rem 0; }
    .join-box {
      background: linear-gradient(135deg, var(--blue) 0%, #5b9dff 100%);
      border-radius: 28px;
      padding: 4rem;
      color: #fff;
      position: relative;
      overflow: hidden;
    }
    .join-box::before {
      content: '';
      position: absolute;
      width: 400px; height: 400px;
      border-radius: 50%;
      background: rgba(255,255,255,0.07);
      top: -150px; right: -80px;
    }
    .join-box .sec-title { color: #fff; }
    .join-box .sec-label { color: rgba(255,255,255,0.6); }
    .join-box p { color: rgba(255,255,255,0.75); font-size: 0.95rem; line-height: 1.8; }
    .btn-white {
      background: #fff;
      color: var(--blue);
      border: none;
      border-radius: 50px;
      padding: 0.9rem 2.2rem;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
      display: inline-block;
    }
    .btn-white:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(0,0,0,0.15); color: var(--blue); }
    .contact-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.88rem;
      color: rgba(255,255,255,0.8);
      margin-bottom: 0.8rem;
    }
    .contact-icon {
      width: 36px; height: 36px;
      border-radius: 10px;
      background: rgba(255,255,255,0.15);
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem;
      flex-shrink: 0;
    }

    /* ─── FOOTER ─── */
    footer {
      background: var(--ink);
      color: #fff;
      padding: 3.5rem 0 2rem;
    }
    .footer-brand {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2rem;
      letter-spacing: 3px;
    }
    .footer-brand span { color: var(--blue); }
    .footer-tagline { font-size: 0.8rem; color: rgba(255,255,255,0.35); margin-top: 0.3rem; }
    .footer-link {
      color: rgba(255,255,255,0.45);
      text-decoration: none;
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      display: block;
      margin-bottom: 0.6rem;
      transition: color 0.2s;
    }
    .footer-link:hover { color: #fff; }
    .footer-col-title {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.25);
      margin-bottom: 1.2rem;
    }
    .footer-social a {
      width: 36px; height: 36px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.12);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: rgba(255,255,255,0.45);
      margin-right: 0.5rem;
      font-size: 0.9rem;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
      text-decoration: none;
    }
    .footer-social a:hover { background: var(--blue); color: #fff; border-color: var(--blue); }
    .footer-divider { border-top: 1px solid rgba(255,255,255,0.07); margin: 2rem 0 1.5rem; }
    .footer-copy { font-size: 0.72rem; color: rgba(255,255,255,0.2); }

    /* ─── ANIMATIONS ─── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .reveal {
      opacity: 0;
      transform: translateY(35px);
      transition: opacity 0.65s ease, transform 0.65s ease;
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* ─── DARK THEME ─── */
    [data-theme="dark"] {
      --bg:    #0f0f0f;
      --bg2:   #1a1a1a;
      --ink:   #f0ede8;
      --muted: #888;
    }
    [data-theme="dark"] .navbar {
      background: rgba(15,15,15,0.92);
      border-bottom-color: rgba(255,255,255,0.07);
    }
    [data-theme="dark"] .hero-badge,
    [data-theme="dark"] .hero-stats,
    [data-theme="dark"] .activity-card,
    [data-theme="dark"] .member-card,
    [data-theme="dark"] .gallery-card,
    [data-theme="dark"] .event-card {
      background: #1e1e1e;
      border-color: rgba(255,255,255,0.07);
    }
    [data-theme="dark"] .hero-stat { border-right-color: rgba(255,255,255,0.08); }
    [data-theme="dark"] .activity-day { background: #2a2a2a; }
    [data-theme="dark"] .about-highlight { background: rgba(26,108,255,0.1); }
    [data-theme="dark"] .floating-pill { background: #1e1e1e; color: var(--ink); }
    [data-theme="dark"] .gallery-hint-pill,
    [data-theme="dark"] .open-hint-pill { background: rgba(30,30,30,0.95); color: #f0ede8; }
    [data-theme="dark"] .album-tag { background: #2a2a2a; color: #999; }
    [data-theme="dark"] .event-footer,
    [data-theme="dark"] .album-footer { border-top-color: rgba(255,255,255,0.07); }
    [data-theme="dark"] .search-box input { background: #2a2a2a; border-color: rgba(255,255,255,0.1); color: var(--ink); }
    [data-theme="dark"] .chip { background: #2a2a2a; border-color: rgba(255,255,255,0.1); }
    [data-theme="dark"] .join-box { background: linear-gradient(135deg,#0d3fa6 0%,#1a6cff 100%); }

    /* sections with hardcoded #fff backgrounds */
    [data-theme="dark"] #about     { background: #141414; }
    [data-theme="dark"] #events    { background: #141414; }
    [data-theme="dark"] #committee { background: #141414; }

    /* footer – var(--ink) would turn WHITE in dark mode, force it dark */
    [data-theme="dark"] footer { background: #050505 !important; }

    /* member social icon buttons */
    [data-theme="dark"] .member-social a { background: #2a2a2a; color: #aaa; }
    [data-theme="dark"] .member-social a:hover { background: var(--blue); color: #fff; }

    /* footer newsletter input */
    [data-theme="dark"] .footer-newsletter-input {
      background: rgba(255,255,255,0.07);
      border-color: rgba(255,255,255,0.1);
      color: #fff;
    }

    /* fact boxes (about section) already use gradient – just keep border subtle */
    [data-theme="dark"] .fact-box { box-shadow: 0 4px 20px rgba(0,0,0,0.4); }

    body, .navbar, .activity-card, .gallery-card, .event-card, .member-card,
    .hero-badge, .hero-stats, .floating-pill, #about, #events, #committee, footer {
      transition: background-color 0.35s ease, color 0.25s ease, border-color 0.35s ease;
    }

    /* ─── THEME TOGGLE BUTTON (fixed bottom-right) ─── */
    .theme-toggle {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 9999;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: 1.5px solid rgba(0,0,0,0.12);
      background: var(--bg2);
      color: var(--ink);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      box-shadow: 0 4px 18px rgba(0,0,0,0.15);
      transition: transform 0.2s, box-shadow 0.2s, background-color 0.35s, border-color 0.35s;
    }
    .theme-toggle:hover { transform: rotate(20deg) scale(1.1); box-shadow: 0 6px 22px rgba(0,0,0,0.22); }
    [data-theme="dark"] .theme-toggle { border-color: rgba(255,255,255,0.14); }

    /* colour helpers */
    .c-blue   { color: var(--blue) !important; }
    .c-orange { color: var(--orange) !important; }
    .c-green  { color: var(--green) !important; }
    .c-purple { color: var(--purple) !important; }
    .c-red    { color: var(--red) !important; }
    .c-teal   { color: var(--teal) !important; }
    .bg-blue   { background: var(--blue) !important; }
    .bg-orange { background: var(--orange) !important; }
    .bg-green  { background: var(--green) !important; }
    .bg-red    { background: var(--red) !important; }
    .bg-teal   { background: var(--teal) !important; }
    .bg-purple { background: var(--purple) !important; }
    .bg-pink   { background: var(--pink) !important; }
    .bg-yellow-dark { background: var(--yellow) !important; }
  </style>
</head>
