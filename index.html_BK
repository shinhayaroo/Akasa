</button>

<!-- ── HERO ── -->
<section id="hero">
  <div class="hero-blob blob1"></div>
  <div class="hero-blob blob2"></div>
  <div class="hero-blob blob3"></div>
  <div class="container">
    <div class="row align-items-center gy-5">
      <div class="col-lg-6">
        <div class="hero-badge">
          <span class="dot"></span>
          Now Open Registration 2025
        </div>
        <h1 class="hero-title">
          <!-- NO<br> -->
           <span class="c-red">No</span>
          <span class="c-black">Pressure</span> <br>
          <span class="c-blue">Just</span>
          <span class="c-orange">Play</span>
        </h1>
        <p class="hero-sub">A vibrant community built for athletes — driven by passion, powered by teamwork. Train hard, compete harder, grow together.</p>
        <div class="hero-cta">
          <a href="#join" class="btn-primary-custom">Join the Club</a>
          <a href="#activities" class="btn-outline-custom">Explore Activities</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat">
            <div class="stat-num c-blue">320+</div>
            <div class="stat-label">Members</div>
          </div>
