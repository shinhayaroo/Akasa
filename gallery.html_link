<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Gallery — AKASA Sports Club</title>

  <link rel="icon" type="image/png" sizes="5x5" href="assets/logo.png">

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Google Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <!-- Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  >

  <style>

    :root {
      --bg: #f7f5f0;
      --ink: #111;
      --muted: #777;
      --blue: #1a6cff;
      --purple: #8b5cf6;
      --card-bg: #fff;
      --card-border: rgba(0,0,0,.05);
      --navbar-bg: rgba(247,245,240,.92);
      --footer-bg: #111;
    }

    html[data-theme="dark"] {
      --bg: #0f0f0f;
      --ink: #f0f0f0;
      --muted: #aaa;
      --blue: #1a6cff;
      --purple: #9d7ff6;
      --card-bg: #1a1a1a;
      --card-border: rgba(255,255,255,.1);
      --navbar-bg: rgba(15,15,15,.95);
      --footer-bg: #0a0a0a;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
    }

    /* =========================
       NAVBAR
    ========================= */

    .navbar {
      background: var(--navbar-bg);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(0,0,0,.07);
      padding: 1rem 0;
      position: sticky;
      top: 0;
      z-index: 999;
    }

    .navbar-brand {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2rem;
      letter-spacing: 3px;
      color: var(--ink) !important;
    }

    .navbar-brand span {
      color: var(--blue);
    }

    .nav-link {
      color: var(--muted) !important;
      font-size: .8rem;
      font-weight: 500;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: .4rem .9rem !important;
    }

    .nav-link:hover,
    .nav-link.active-link {
      color: var(--ink) !important;
      font-weight: 600;
    }

    .btn-nav {
      background: var(--blue);
      color: #fff !important;
      border-radius: 50px;
      padding: .5rem 1.4rem !important;
      font-size: .78rem !important;
      font-weight: 600 !important;
    }

    /* =========================
       THEME TOGGLE
    ========================= */

    .theme-toggle {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 9999;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: 1.5px solid rgba(0,0,0,.12);
      background: var(--bg);
      color: var(--ink);
      cursor: pointer;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 1.1rem;

      box-shadow: 0 4px 18px rgba(0,0,0,.15);

      transition:
        transform .2s,
        box-shadow .2s,
        background-color .35s,
        border-color .35s;
    }

    .theme-toggle:hover {
      transform: rotate(20deg) scale(1.1);
      box-shadow: 0 6px 22px rgba(0,0,0,.22);
    }

    html[data-theme="dark"] .theme-toggle {
      border-color: rgba(255,255,255,.14);
    }

    /* =========================
       HERO
    ========================= */

    .page-hero {
      background: var(--bg);
      padding: 5rem 0 3.5rem;
      position: relative;
      overflow: hidden;
    }

    .ph-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      opacity: .16;
      pointer-events: none;
    }

    .pb1 {
      width: 500px;
      height: 500px;
      background: var(--purple);
      top: -180px;
      right: -100px;
    }

    .pb2 {
      width: 300px;
      height: 300px;
      background: #ff7c2a;
      bottom: -80px;
      left: -60px;
    }

    .pb3 {
      width: 220px;
      height: 220px;
      background: #00b4a0;
      top: 40%;
      left: 38%;
    }

    .breadcrumb-row {
      display: flex;
      align-items: center;
      gap: .5rem;

      font-size: .72rem;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;

      color: var(--muted);
      margin-bottom: 1.5rem;
    }

    .breadcrumb-row a {
      color: var(--blue);
      text-decoration: none;
    }

    .page-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3.5rem, 10vw, 8rem);
      line-height: .92;
      letter-spacing: -1px;
    }

    .page-title .c-purple {
      color: var(--purple);
    }

    .hero-desc {
      font-size: 1rem;
      color: var(--muted);
      max-width: 520px;
      line-height: 1.8;
      margin-top: 1.2rem;
    }

    .stat-pills {
      display: flex;
      flex-wrap: wrap;
      gap: .6rem;
      margin-top: 2rem;
    }

    .stat-pill {
      display: inline-flex;
      align-items: center;
      gap: .45rem;

      background: var(--card-bg);
      border: 1.5px solid var(--card-border);
      border-radius: 50px;

      padding: .4rem 1rem;

      font-size: .72rem;
      font-weight: 600;

      box-shadow: 0 2px 10px rgba(0,0,0,.05);
    }

    .stat-pill b {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.1rem;
    }

    /* =========================
       SCROLL DATE INDICATOR
    ========================= */

    .scroll-date-indicator {
      position: fixed;
      top: 50%;
      right: 24px;

      z-index: 900;

      display: flex;
      align-items: center;
      gap: .45rem;

      padding: .55rem .9rem;

      border-radius: 999px;

      background: rgba(255,255,255,.92);
      border: 1px solid rgba(0,0,0,.08);

      box-shadow: 0 6px 22px rgba(0,0,0,.08);

      backdrop-filter: blur(12px);

      opacity: 0;

      transform:
        translateY(-50%)
        translateX(10px);

      pointer-events: none;

      transition:
        opacity .2s ease,
        transform .2s ease;
    }

    .scroll-date-indicator.visible {
      opacity: 1;

      transform:
        translateY(-50%)
        translateX(0);
    }

    .scroll-date-indicator #scrollMonth {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.15rem;
      letter-spacing: .7px;
      color: var(--ink);
    }

    .scroll-date-indicator #scrollYear {
      font-size: .72rem;
      font-weight: 700;
      color: var(--muted);
      letter-spacing: 1px;
    }

    html[data-theme="dark"] .scroll-date-indicator {
      background: rgba(30,30,30,.95);
      border-color: rgba(255,255,255,.12);
      box-shadow: 0 6px 22px rgba(0,0,0,.3);
    }

    /* =========================
       GALLERY
    ========================= */

    .gallery-wrap {
      padding: 2.5rem 0 4rem;
    }

    .photo-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.15rem;
    }

    .photo-card {
      position: relative;

      aspect-ratio: 4/3;

      overflow: hidden;

      border-radius: 16px;

      background: var(--card-bg);

      cursor: pointer;

      border: 1.5px solid var(--card-border);

      box-shadow: 0 4px 18px rgba(0,0,0,.05);

      transition:
        transform .3s ease,
        box-shadow .3s ease;
    }

    .photo-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(0,0,0,.12);
    }

    .photo-card img {
      width: 100%;
      height: 100%;

      object-fit: cover;

      display: block;

      transition: transform .45s ease;
    }

    .photo-card:hover img {
      transform: scale(1.06);
    }

    /* =========================
       IMAGE ERROR
    ========================= */

    .image-error {
      width: 100%;
      height: 100%;

      display: flex;
      align-items: center;
      justify-content: center;

      flex-direction: column;

      gap: .5rem;

      color: var(--muted);

      font-size: .75rem;

      text-align: center;

      padding: 1rem;
    }

    .image-error i {
      font-size: 2rem;
    }

    /* =========================
       LIGHTBOX
    ========================= */

    .gallery-lightbox {
      position: fixed;
      inset: 0;

      background: rgba(0,0,0,.96);

      z-index: 9999;

      opacity: 0;

      pointer-events: none;

      transition: opacity .25s ease;

      display: flex;

      align-items: center;
      justify-content: center;
    }

    .gallery-lightbox.open {
      opacity: 1;
      pointer-events: auto;
    }

    .lightbox-image {
      max-width: calc(100vw - 140px);
      max-height: calc(100vh - 100px);

      width: auto;
      height: auto;

      object-fit: contain;

      display: block;

      transition: opacity .2s ease;
    }

    .lightbox-close,
    .lightbox-nav {
      position: absolute;

      width: 48px;
      height: 48px;

      border: 0;
      border-radius: 50%;

      background: rgba(255,255,255,.12);

      color: #fff;

      display: flex;
      align-items: center;
      justify-content: center;

      cursor: pointer;

      transition:
        background .2s ease,
        transform .2s ease;

      z-index: 2;
    }

    .lightbox-close:hover,
    .lightbox-nav:hover {
      background: rgba(255,255,255,.22);
    }

    .lightbox-close {
      top: 20px;
      right: 20px;
      font-size: 1.15rem;
    }

    .lightbox-nav {
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.2rem;
    }

    .lightbox-nav.prev {
      left: 22px;
    }

    .lightbox-nav.next {
      right: 22px;
    }

    .lightbox-counter {
      position: absolute;

      top: 25px;
      left: 50%;

      transform: translateX(-50%);

      color: rgba(255,255,255,.7);

      font-size: .72rem;
      font-weight: 600;
      letter-spacing: 1px;
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      background: var(--footer-bg);
      color: #fff;

      padding: 3rem 0 2rem;

      margin-top: 2rem;
    }

    .footer-brand {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2rem;
      letter-spacing: 3px;
    }

    .footer-brand span {
      color: var(--blue);
    }

    .footer-link {
      color: rgba(255,255,255,.4);

      text-decoration: none;

      font-size: .78rem;
      font-weight: 500;
      letter-spacing: 1.5px;

      text-transform: uppercase;

      display: inline-block;

      margin: 0 .75rem;
    }

    .footer-link:hover {
      color: #fff;
    }

    .footer-copy {
      font-size: .72rem;
      color: rgba(255,255,255,.2);
      margin-top: 1.5rem;
    }

    .footer-social a {
      width: 34px;
      height: 34px;

      border-radius: 50%;

      border: 1px solid rgba(255,255,255,.1);

      display: inline-flex;
      align-items: center;
      justify-content: center;

      color: rgba(255,255,255,.4);

      margin: 0 .25rem;

      text-decoration: none;
    }

    .footer-social a:hover {
      background: var(--blue);
      color: #fff;
      border-color: var(--blue);
    }

    .footer-divider {
      border-top: 1px solid rgba(255,255,255,.07);
      margin: 2rem 0 1.5rem;
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @media(max-width:1100px) {

      .photo-grid {
        grid-template-columns: repeat(3, minmax(0,1fr));
      }

    }

    @media(max-width:800px) {

      .scroll-date-indicator {
        right: 12px;
        padding: .45rem .75rem;
      }

      .scroll-date-indicator #scrollMonth {
        font-size: 1rem;
      }

      .scroll-date-indicator #scrollYear {
        font-size: .65rem;
      }

      .photo-grid {
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: .8rem;
      }

      .lightbox-image {
        max-width: calc(100vw - 80px);
        max-height: calc(100vh - 80px);
      }

      .lightbox-nav {
        width: 40px;
        height: 40px;
      }

      .lightbox-nav.prev {
        left: 10px;
      }

      .lightbox-nav.next {
        right: 10px;
      }

    }

    @media(max-width:480px) {

      .photo-grid {
        grid-template-columns: 1fr;
      }

      .photo-card {
        aspect-ratio: 16/10;
      }

      .page-hero {
        padding: 3.5rem 0 2.5rem;
      }

      .lightbox-close {
        top: 12px;
        right: 12px;
      }

      .lightbox-counter {
        top: 18px;
      }

    }

  </style>
</head>


<body>

  <!-- =========================
       NAVBAR
  ========================= -->

  <nav class="navbar navbar-expand-lg">

    <div class="container">

      <a class="navbar-brand" href="index.html">
        AKASA<span>.</span>
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navMenu"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div
        class="collapse navbar-collapse justify-content-end"
        id="navMenu"
      >

        <ul class="navbar-nav align-items-lg-center gap-lg-1">

          <li class="nav-item">
            <a class="nav-link" href="index.html">
              Home
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="index.html#about">
              About
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="index.html#activities">
              Activities
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link active-link" href="gallery.html">
              Gallery
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="index.html#committee">
              Committee
            </a>
          </li>

          <li class="nav-item ms-lg-2">
            <a class="nav-link btn-nav" href="index.html#join">
              Join Us
            </a>
          </li>

        </ul>

      </div>

    </div>

  </nav>


  <!-- =========================
       HERO
  ========================= -->

  <section class="page-hero">

    <div class="ph-blob pb1"></div>
    <div class="ph-blob pb2"></div>
    <div class="ph-blob pb3"></div>

    <div class="container">

      <div class="breadcrumb-row">

        <a href="index.html">
          Home
        </a>

        <i class="bi bi-chevron-right"></i>

        <span>
          Gallery
        </span>

      </div>


      <h1 class="page-title">
        PHOTO<br>
        <span class="c-purple">
          GALLERY
        </span>
      </h1>


      <p class="hero-desc">
        Relive the action, the victories, and the community spirit.
      </p>


      <div class="stat-pills">

        <div class="stat-pill">

          <i
            class="bi bi-images"
            style="color:var(--purple)"
          ></i>

          <b id="photoCount">0</b>

          Photos

        </div>


        <div class="stat-pill">

          <i
            class="bi bi-sort-down"
            style="color:var(--blue)"
          ></i>

          Latest First

        </div>

      </div>

    </div>

  </section>


  <!-- =========================
       SCROLL DATE INDICATOR
  ========================= -->

  <div
    class="scroll-date-indicator"
    id="scrollDateIndicator"
    aria-hidden="true"
  >

    <span id="scrollMonth">
      March
    </span>

    <span id="scrollYear">
      2025
    </span>

  </div>


  <!-- =========================
       GALLERY
  ========================= -->

  <main class="gallery-wrap">

    <div class="container">

      <div
        id="photoGrid"
        class="photo-grid"
      ></div>

    </div>

  </main>


  <!-- =========================
       LIGHTBOX
  ========================= -->

  <div
    class="gallery-lightbox"
    id="galleryLightbox"
    aria-hidden="true"
  >

    <div class="lightbox-counter">

      <span id="lightboxCurrent">
        1
      </span>

      /

      <span id="lightboxTotal">
        1
      </span>

    </div>


    <button
      class="lightbox-close"
      id="lightboxClose"
      aria-label="Close"
    >
      <i class="bi bi-x-lg"></i>
    </button>


    <button
      class="lightbox-nav prev"
      id="lightboxPrev"
      aria-label="Previous photo"
    >
      <i class="bi bi-chevron-left"></i>
    </button>


    <img
      class="lightbox-image"
      id="lightboxImage"
      src=""
      alt="AKASA Sports Club gallery photo"
    >


    <button
      class="lightbox-nav next"
      id="lightboxNext"
      aria-label="Next photo"
    >
      <i class="bi bi-chevron-right"></i>
    </button>

  </div>


  <!-- =========================
       FOOTER
  ========================= -->

  <footer>

    <div class="container text-center">

      <div class="footer-brand mb-2">
        AKASA<span>.</span>
      </div>


      <div class="mb-3">

        <a
          href="index.html#about"
          class="footer-link"
        >
          About
        </a>

        <a
          href="index.html#activities"
          class="footer-link"
        >
          Activities
        </a>

        <a
          href="events.html"
          class="footer-link"
        >
          Events
        </a>

        <a
          href="gallery.html"
          class="footer-link"
        >
          Gallery
        </a>

        <a
          href="index.html#committee"
          class="footer-link"
        >
          Committee
        </a>

        <a
          href="index.html#join"
          class="footer-link"
        >
          Join Us
        </a>

      </div>


      <div class="footer-social mb-3">

        <a href="#">
          <i class="bi bi-instagram"></i>
        </a>

        <a href="#">
          <i class="bi bi-facebook"></i>
        </a>

        <a href="#">
          <i class="bi bi-twitter-x"></i>
        </a>

      </div>


      <div class="footer-divider"></div>


      <div class="footer-copy">
        © 2025 AKASA Sports Club. All rights reserved.
      </div>

    </div>

  </footer>


  <!-- =========================
       THEME TOGGLE
  ========================= -->

  <button
    class="theme-toggle"
    id="themeToggle"
    title="Toggle dark / light mode"
  >

    <i
      class="bi bi-moon-fill"
      id="themeIcon"
    ></i>

  </button>


  <!-- Bootstrap JS -->

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


  <script>

    /* ============================================================
       DARK / LIGHT THEME
    ============================================================ */

    (function () {

      const root =
        document.documentElement;

      const toggleBtn =
        document.getElementById("themeToggle");

      const themeIcon =
        document.getElementById("themeIcon");


      function applyTheme(dark) {

        root.setAttribute(
          "data-theme",
          dark ? "dark" : "light"
        );


        themeIcon.className =
          dark
            ? "bi bi-sun-fill"
            : "bi bi-moon-fill";


        localStorage.setItem(
          "akasa-theme",
          dark ? "dark" : "light"
        );

      }


      const saved =
        localStorage.getItem("akasa-theme");


      applyTheme(
        saved
          ? saved === "dark"
          : true
      );


      toggleBtn.addEventListener(
        "click",
        () => {

          applyTheme(
            root.getAttribute("data-theme") !== "dark"
          );

        }
      );

    })();


    /* ============================================================
       GOOGLE DRIVE IMAGE HELPER
    ============================================================

       IMPORTANT:

       Google Drive file must be:

       Share
       → General access
       → Anyone with the link
       → Viewer

       We use the thumbnail URL because it works
       with the Drive image you tested.
    ============================================================ */

    function googleDriveImage(fileId) {

      return `https://drive.google.com/thumbnail?id=${fileId}&sz=w1600`;

    }


    /* ============================================================
       PHOTO DATA
    ============================================================ */

    const albums = [
  {
    title: "AKASA Cup Futsal Tournament 2025",
    date: "15 March 2025",

    photos: [
      ["15 Mar 2025 · 8:00 AM", "1ci1OqwN0ms2Dt93x4F0SIwVHAXR95QL-"],
      ["15 Mar 2025 · 9:15 AM", "1VtQXvH9tg3gIThgxgyLBsfBYYhjTmtLG"],
      ["15 Mar 2025 · 12:00 PM", "1_M-t6MdS3Vx0WPYcKdOOUgqS273EvdYO"],
      ["15 Mar 2025 · 3:00 PM", "1Ru9WoIXhOD0_bxl9G3k0UbjKYCucG_BX"],
      ["15 Mar 2025 · 5:20 PM", "1g7ii7v8LEontvbVl_gw4dZanw_NpboVG"]
    ]
  }
];


    /* ============================================================
       FLATTEN ALL PHOTOS
    ============================================================ */

    const allPhotos =
      albums.flatMap(
        album =>
          album.photos.map(
            photo => ({
              src: googleDriveImage(photo[1]),
              date: photo[0]
            })
          )
      );


    /* ============================================================
       DATE PARSER
    ============================================================ */

    function parsePhotoDate(value) {

      if (!value) {
        return new Date(0);
      }


      const match =
        value.match(
          /^(\d{1,2})\s+([A-Za-z]{3})\s+(\d{4})(?:\s+·\s+(\d{1,2}):(\d{2})\s*(AM|PM))?/
        );


      if (!match) {
        return new Date(0);
      }


      const [
        ,
        day,
        monthName,
        year,
        hour = "0",
        minute = "0",
        ampm
      ] = match;


      const months = {

        Jan: 0,
        Feb: 1,
        Mar: 2,
        Apr: 3,
        May: 4,
        Jun: 5,
        Jul: 6,
        Aug: 7,
        Sep: 8,
        Oct: 9,
        Nov: 10,
        Dec: 11

      };


      const month =
        months[monthName];


      if (month === undefined) {
        return new Date(0);
      }


      let hours =
        Number(hour);


      if (
        ampm === "PM" &&
        hours !== 12
      ) {

        hours += 12;

      }


      if (
        ampm === "AM" &&
        hours === 12
      ) {

        hours = 0;

      }


      return new Date(
        Number(year),
        month,
        Number(day),
        hours,
        Number(minute),
        0
      );

    }


    /* ============================================================
       SORT LATEST → OLDEST
    ============================================================ */

    allPhotos.sort(
      (a, b) =>
        parsePhotoDate(b.date) -
        parsePhotoDate(a.date)
    );


    /* ============================================================
       DOM ELEMENTS
    ============================================================ */

    const photoGrid =
      document.getElementById(
        "photoGrid"
      );


    const photoCount =
      document.getElementById(
        "photoCount"
      );


    const scrollDateIndicator =
      document.getElementById(
        "scrollDateIndicator"
      );


    const scrollMonth =
      document.getElementById(
        "scrollMonth"
      );


    const scrollYear =
      document.getElementById(
        "scrollYear"
      );


    photoCount.textContent =
      allPhotos.length;


    /* ============================================================
       IMAGE URL TEST
    ============================================================ */

    console.log(
      "AKASA Gallery photos:",
      allPhotos
    );


    /* ============================================================
       RENDER PHOTO GRID
    ============================================================ */

    allPhotos.forEach(
      (photo, index) => {

        const card =
          document.createElement(
            "div"
          );


        card.className =
          "photo-card";


        card.dataset.photoIndex =
          index;


        card.dataset.photoDate =
          parsePhotoDate(
            photo.date
          ).getTime();


        card.tabIndex = 0;


        card.setAttribute(
          "role",
          "button"
        );


        card.setAttribute(
          "aria-label",
          "Open gallery photo"
        );


        const image =
          document.createElement(
            "img"
          );


        /*
         * Set the exact URL here.
         */
        image.src =
          photo.src;


        image.alt =
          "AKASA Sports Club gallery photo";


        /*
         * First 8 images load immediately.
         */
        image.loading =
          index < 8
            ? "eager"
            : "lazy";


        image.decoding =
          "async";


        /*
         * Google Drive debugging.
         */
        image.onload =
          function () {

            console.log(
              "Image loaded successfully:",
              photo.src
            );

          };


        image.onerror =
          function () {

            console.error(
              "FAILED TO LOAD IMAGE:",
              photo.src
            );


            const error =
              document.createElement(
                "div"
              );


            error.className =
              "image-error";


            error.innerHTML = `

              <i class="bi bi-image"></i>

              <span>
                Image could not be loaded
              </span>

            `;


            /*
             * Show the failed URL
             * in the browser console.
             */
            console.error(
              "Photo:",
              photo
            );


            this.remove();


            card.appendChild(
              error
            );

          };


        card.appendChild(
          image
        );


        /* =========================
           CLICK
        ========================= */

        card.addEventListener(
          "click",
          () =>
            openLightbox(index)
        );


        /* =========================
           KEYBOARD
        ========================= */

        card.addEventListener(
          "keydown",
          event => {

            if (
              event.key === "Enter" ||
              event.key === " "
            ) {

              event.preventDefault();

              openLightbox(index);

            }

          }
        );


        photoGrid.appendChild(
          card
        );

      }
    );


    /* ============================================================
       PHOTO CARDS
    ============================================================ */

    const photoCards =
      Array.from(
        document.querySelectorAll(
          ".photo-card"
        )
      );


    /* ============================================================
       MONTH / YEAR
    ============================================================ */

    function getPhotoMonthYear(
      photo
    ) {

      const date =
        parsePhotoDate(
          photo.date
        );


      return {

        month:
          date.toLocaleDateString(
            "en-US",
            {
              month: "long"
            }
          ),

        year:
          date.getFullYear()

      };

    }


    function updateScrollDate() {

      if (
        !photoCards.length
      ) {

        return;

      }


      const referenceY =
        150;


      let activeIndex =
        0;


      for (
        let i = 0;
        i < photoCards.length;
        i++
      ) {

        const rect =
          photoCards[i]
            .getBoundingClientRect();


        if (
          rect.top <= referenceY
        ) {

          activeIndex = i;

        } else {

          break;

        }

      }


      const activePhoto =
        allPhotos[
          activeIndex
        ];


      if (!activePhoto) {
        return;
      }


      const date =
        getPhotoMonthYear(
          activePhoto
        );


      scrollMonth.textContent =
        date.month;


      scrollYear.textContent =
        date.year;


      if (
        window.scrollY > 250
      ) {

        scrollDateIndicator
          .classList
          .add("visible");

      } else {

        scrollDateIndicator
          .classList
          .remove("visible");

      }

    }


    let scrollTicking =
      false;


    window.addEventListener(
      "scroll",
      () => {

        if (!scrollTicking) {

          window.requestAnimationFrame(
            () => {

              updateScrollDate();

              scrollTicking =
                false;

            }
          );


          scrollTicking =
            true;

        }

      },
      {
        passive: true
      }
    );


    window.addEventListener(
      "resize",
      updateScrollDate
    );


    updateScrollDate();


    /* ============================================================
       LIGHTBOX
    ============================================================ */

    const lightbox =
      document.getElementById(
        "galleryLightbox"
      );


    const lightboxImage =
      document.getElementById(
        "lightboxImage"
      );


    const lightboxCurrent =
      document.getElementById(
        "lightboxCurrent"
      );


    const lightboxTotal =
      document.getElementById(
        "lightboxTotal"
      );


    let currentIndex =
      0;


    lightboxTotal.textContent =
      allPhotos.length;


    /* =========================
       OPEN
    ========================= */

    function openLightbox(
      index
    ) {

      currentIndex =
        index;


      updateLightbox();


      lightbox.classList.add(
        "open"
      );


      lightbox.setAttribute(
        "aria-hidden",
        "false"
      );


      document.body.style.overflow =
        "hidden";

    }


    /* =========================
       CLOSE
    ========================= */

    function closeLightbox() {

      lightbox.classList.remove(
        "open"
      );


      lightbox.setAttribute(
        "aria-hidden",
        "true"
      );


      document.body.style.overflow =
        "";

    }


    /* =========================
       UPDATE
    ========================= */

    function updateLightbox() {

      const photo =
        allPhotos[
          currentIndex
        ];


      if (!photo) {
        return;
      }


      lightboxImage.style.opacity =
        "0";


      /*
       * Use the exact same URL
       * that the gallery card uses.
       */

      setTimeout(
        () => {

          lightboxImage.src =
            photo.src;


          lightboxImage.alt =
            "AKASA Sports Club gallery photo";


          lightboxImage.onload =
            () => {

              lightboxImage.style.opacity =
                "1";

            };


          lightboxImage.onerror =
            () => {

              console.error(
                "Lightbox failed:",
                photo.src
              );

              lightboxImage.style.opacity =
                "1";

            };

        },
        100
      );


      lightboxCurrent.textContent =
        currentIndex + 1;

    }


    /* =========================
       PREVIOUS
    ========================= */

    function previousPhoto() {

      currentIndex =
        (
          currentIndex -
          1 +
          allPhotos.length
        ) %
        allPhotos.length;


      updateLightbox();

    }


    /* =========================
       NEXT
    ========================= */

    function nextPhoto() {

      currentIndex =
        (
          currentIndex +
          1
        ) %
        allPhotos.length;


      updateLightbox();

    }


    /* =========================
       BUTTONS
    ========================= */

    document
      .getElementById(
        "lightboxClose"
      )
      .addEventListener(
        "click",
        closeLightbox
      );


    document
      .getElementById(
        "lightboxPrev"
      )
      .addEventListener(
        "click",
        previousPhoto
      );


    document
      .getElementById(
        "lightboxNext"
      )
      .addEventListener(
        "click",
        nextPhoto
      );


    /* =========================
       CLICK OUTSIDE
    ========================= */

    lightbox.addEventListener(
      "click",
      event => {

        if (
          event.target ===
          lightbox
        ) {

          closeLightbox();

        }

      }
    );


    /* =========================
       KEYBOARD
    ========================= */

    document.addEventListener(
      "keydown",
      event => {

        if (
          !lightbox.classList.contains(
            "open"
          )
        ) {

          return;

        }


        if (
          event.key ===
          "ArrowLeft"
        ) {

          previousPhoto();

        }


        if (
          event.key ===
          "ArrowRight"
        ) {

          nextPhoto();

        }


        if (
          event.key ===
          "Escape"
        ) {

          closeLightbox();

        }

      }
    );

  </script>

</body>

</html>